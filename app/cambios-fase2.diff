+/* ============ AUTH (Supabase) ============ */
+// Valores de Supabase → Project Settings → API.
+// La anon (publishable) key puede estar en el frontend: la seguridad la da el RLS.
+// NUNCA poner aquí la service_role (secret) key.
+const SUPABASE_URL='';
+const SUPABASE_ANON_KEY='';
+
+const ROLE_LABELS={ADMIN:'Admin',QA_LEAD:'QA Lead',QA:'QA'};
+let supabaseClient=null, currentUser=null;
+
+function canManageConfig(){return !!currentUser&&(currentUser.role==='ADMIN'||currentUser.role==='QA_LEAD');}
+function isAdmin(){return !!currentUser&&currentUser.role==='ADMIN';}
+
+function showAuth(state,message){
+  document.body.classList.add('auth-locked');
+  document.getElementById('auth-loading').hidden=state!=='loading';
+  document.getElementById('auth-form').hidden=state!=='login';
+  document.getElementById('auth-blocked').hidden=state!=='blocked';
+  if(state==='login'){
+    const err=document.getElementById('auth-error');
+    err.className=message?'status-msg error':'status-msg';
+    err.textContent=message||'';
+    document.getElementById(message?'auth-password':'auth-email').focus();
+  }
+  if(state==='blocked'){
+    document.getElementById('auth-blocked-text').textContent=message;
+    document.getElementById('auth-blocked-logout').hidden=!supabaseClient;
+  }
+}
+
+function showApp(){
+  document.body.classList.remove('auth-locked');
+  renderUserInfo();
+  applyPermissions();
+}
+
+async function initAuth(){
+  if(!SUPABASE_URL||!SUPABASE_ANON_KEY){showAuth('blocked','Falta configurar SUPABASE_URL y SUPABASE_ANON_KEY en este archivo.');return;}
+  if(!window.supabase){showAuth('blocked','No se pudo cargar la librería de Supabase. Revisá la conexión y recargá la página.');return;}
+  supabaseClient=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);
+  // Solo UI aquí: supabase-js no permite llamar a otros métodos de auth dentro de este callback.
+  supabaseClient.auth.onAuthStateChange(event=>{
+    if(event==='SIGNED_OUT'){currentUser=null;showAuth('login');}
+  });
+  const {data:{session}}=await supabaseClient.auth.getSession();
+  if(!session){showAuth('login');return;}
+  await enterWithSession();
+}
+
+async function loadCurrentProfile(){
+  const {data:{user},error:userError}=await supabaseClient.auth.getUser();
+  if(userError)throw userError;
+  const {data,error}=await supabaseClient.from('profiles').select('id,full_name,email,role,active').eq('id',user.id).maybeSingle();
+  if(error)throw error;
+  return data;
+}
+
+async function enterWithSession(){
+  showAuth('loading');
+  try{
+    currentUser=await loadCurrentProfile();
+  }catch(e){
+    console.error('No se pudo cargar el perfil',e);
+    currentUser=null;
+    if(e&&(e.status===401||e.status===403||e.name==='AuthSessionMissingError')){
+      // Sesión vencida o usuario eliminado: se descarta la sesión guardada.
+      await supabaseClient.auth.signOut({scope:'local'});
+      showAuth('login','Tu sesión expiró. Iniciá sesión de nuevo.');
+    }else{
+      showAuth('blocked','No se pudo cargar tu perfil. Revisá la conexión y recargá la página.');
+    }
+    return;
+  }
+  if(!currentUser){showAuth('blocked','Tu usuario no tiene perfil en QA BCR Suite. Pedile a un administrador que lo revise.');return;}
+  if(!currentUser.active){showAuth('blocked','Tu usuario está desactivado. Pedile a un administrador que lo reactive.');return;}
+  showApp();
+}
+
+function loginErrorMessage(error){
+  if(error.code==='invalid_credentials'||/invalid login credentials/i.test(error.message||''))return 'Correo o contraseña incorrectos.';
+  if(error.code==='email_not_confirmed')return 'El correo no está confirmado. Pedile a un administrador que lo confirme en Supabase.';
+  if(error.status===429)return 'Demasiados intentos. Esperá un momento e intentá de nuevo.';
+  if(error.name==='AuthRetryableFetchError'||!error.status)return 'No se pudo conectar con el servidor. Revisá la conexión.';
+  return 'No se pudo iniciar sesión: '+error.message;
+}
+
+async function onLoginSubmit(event){
+  event.preventDefault();
+  const btn=document.getElementById('auth-submit');
+  const email=document.getElementById('auth-email').value.trim();
+  const password=document.getElementById('auth-password').value;
+  btn.disabled=true;btn.textContent='Ingresando...';
+  let error=null;
+  try{({error}=await supabaseClient.auth.signInWithPassword({email,password}));}
+  catch(e){error=e;}
+  btn.disabled=false;btn.textContent='Iniciar sesión';
+  if(error){showAuth('login',loginErrorMessage(error));return;}
+  document.getElementById('auth-password').value='';
+  await enterWithSession();
+}
+
+async function logout(){
+  if(supabaseClient){
+    try{const {error}=await supabaseClient.auth.signOut();if(error)throw error;}
+    catch(e){await supabaseClient.auth.signOut({scope:'local'});}
+  }
+  location.reload();
+}
+
+function renderUserInfo(){
+  const name=currentUser.full_name||currentUser.email||'';
+  document.getElementById('sidebar-user-name').textContent=name;
+  document.getElementById('sidebar-user-role').textContent=ROLE_LABELS[currentUser.role]||currentUser.role;
+  document.getElementById('mobile-logout').title='Cerrar sesión ('+name+')';
+}
+
+// Mejora la UI; la protección real está en el RLS de Supabase.
+function applyPermissions(){
+  const lead=canManageConfig();
+  document.getElementById('nav-admin').hidden=!lead;
+  document.getElementById('mnav-admin').hidden=!lead;
+  document.getElementById('atab-users').hidden=!isAdmin();
+  if(!isAdmin()&&document.getElementById('asec-users').classList.contains('active'))selectAdminTab('people');
+  if(!lead&&document.getElementById('page-admin').classList.contains('active'))showPage('home');
+}
+
+/* ============ ADMIN: USUARIOS ============ */
+async function renderUsersAdmin(){
+  const box=document.getElementById('list-users');
+  if(!isAdmin()){box.innerHTML='';return;}
+  box.innerHTML='<div class="crud-empty">Cargando usuarios...</div>';
+  const {data,error}=await supabaseClient.from('profiles').select('id,full_name,email,role,active').order('full_name');
+  if(error){box.innerHTML='<div class="crud-empty">⚠ No se pudieron cargar los usuarios.</div>';return;}
+  box.innerHTML=data.length?data.map(u=>{
+    const self=u.id===currentUser.id;
+    const lock=self?' disabled title="No podés cambiar tu propio usuario"':'';
+    const options=Object.keys(ROLE_LABELS).map(r=>`<option value="${r}"${r===u.role?' selected':''}>${ROLE_LABELS[r]}</option>`).join('');
+    return `<div class="crud-item">
+      <span class="crud-item-name">${escapeHtml(u.full_name)}${self?' (vos)':''}<span class="user-email">${escapeHtml(u.email||'')}</span></span>
+      <select class="user-role-select" aria-label="Rol de ${escapeHtml(u.full_name)}" data-id="${u.id}"${lock} onchange="updateUser(this.dataset.id,{role:this.value},this)">${options}</select>
+      <label class="crud-label-small"><input type="checkbox" class="crud-checkbox" data-id="${u.id}"${u.active?' checked':''}${lock} onchange="updateUser(this.dataset.id,{active:this.checked},this)"> Activo</label>
+    </div>`;
+  }).join(''):'<div class="crud-empty">No hay usuarios.</div>';
+}
+
+async function updateUser(id,changes,input){
+  const st=document.getElementById('users-status');
+  st.className='status-msg info';st.textContent='Guardando...';
+  input.disabled=true;
+  const {data,error}=await supabaseClient.from('profiles').update(changes).eq('id',id).select('id');
+  input.disabled=false;
+  if(error||!data||!data.length){
+    // Supabase rechazó el cambio: se vuelve a mostrar lo que hay en la base.
+    st.className='status-msg error';
+    st.textContent='⚠ No se pudo guardar.'+(error?' '+error.message:' No tenés permiso para este cambio.');
+    await renderUsersAdmin();
+    return;
+  }
+  st.className='status-msg ok';st.textContent='✓ Guardado';
+}
+
 /* ============ INIT ============ */
 renderProjectButtons();
 updateDailyCounts();
@@ -1330,6 +1563,8 @@
   }
   banner.classList.add('visible');
 })();
+
+initAuth();
 </script>
